<SplitPane dividerPositions="0.045" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" orientation="VERTICAL" prefHeight="880.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.apply.kmcg.MainController">
    <items>
      <Pane prefHeight="21.0" prefWidth="1300.0">
         <children>
                <MenuBar prefHeight="37.0" prefWidth="275.0">
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleOpenFile" text="Open" />
                                <MenuItem mnemonicParsing="false" onAction="#handleSavePicture" text="Save Image" />

                            </items>
                        </Menu>

                  <Menu mnemonicParsing="false" text="View">
                     <items>
                         <MenuItem mnemonicParsing="false" onAction="#handleDetailClick" text="Detail" />
                         <MenuItem mnemonicParsing="false" onAction="#handleCoordinatePointsClick" text="Current coordinates" />

                     </items>
                  </Menu>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" text="About" onAction="#handleAbout" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
         </children>
      </Pane>

        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="819.0" prefWidth="1300.0">
            <children>
                <TabPane fx:id="tabPane" prefHeight="835.0" prefWidth="1300.0">

                    <tabs>
                        <Tab fx:id="tabKMCG" closable="false" text="KMCG">

                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <StackPane>
                                    <AnchorPane>
                                    <Canvas fx:id="KMCGCanvas" height="820.0" width="1300.0" />


                                        <Button fx:id="listButton"  onAction="#handleListButton"
                                                prefWidth="40.0" prefHeight="30.0"
                                                AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="70.0"
                                                style="-fx-background-color: transparent; -fx-border-width: 0;"
                                        >
                                            <graphic>
                                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                                    <image>
                                                        <Image url="@image/list.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>

                                        <Button fx:id="switchButton" onAction="#handleSwitchButton"
                                                prefWidth="40.0" prefHeight="30.0"
                                                AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="130.0">
                                            <graphic>
                                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                                    <image>
                                                        <Image url="@image/switch.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>

                                        <Button fx:id="magnificationButton" onAction="#handleMagnificationButton"
                                                prefWidth="40.0" prefHeight="30.0"
                                                AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="190.0">
                                            <graphic>
                                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                                    <image>
                                                        <Image url="@image/magnifier.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>

                                        <Button fx:id="coordinateButton" onAction="#handleCoordinateButton"
                                                prefWidth="40.0" prefHeight="30.0"
                                                AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="250.0">
                                            <graphic>
                                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                                    <image>
                                                        <Image url="@image/coordinate.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>


                                        <Button fx:id="freshButton" onAction="#handleFreshButton"
                                                prefWidth="40.0" prefHeight="30.0"
                                                AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="310.0">
                                            <graphic>
                                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                                    <image>
                                                        <Image url="@image/refresh.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>

                                        <Button fx:id="searchButton" onAction="#handleSearchButton"
                                                prefWidth="40.0" prefHeight="30.0"
                                                AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="370.0">
                                            <graphic>
                                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                                    <image>
                                                        <Image url="@image/search.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>


                                    </AnchorPane>
                                </StackPane>

                            </HBox>
                        </Tab>
                        <Tab fx:id="tabKMer" closable="false" text="K-mer">
                            <ScrollPane fx:id="scrollPane" fitToWidth="false" prefHeight="820.0" prefWidth="1300.0">
                                <content>
                                    <Canvas fx:id="KmerCanvas" width="1300.0" />

                                </content>
                            </ScrollPane>
                        </Tab>
                        <Tab fx:id="tabQuality" closable="false" text="Quality">

                            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                                <GridPane fx:id="qualityLayoutGrid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="1200" prefWidth="1200" maxWidth="1200" />
                                        <ColumnConstraints minWidth="400" prefWidth="400" maxWidth="400" halignment="CENTER" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="754" prefHeight="754" maxHeight="754" vgrow="NEVER" />
                                    </rowConstraints>

                                    <!-- 左侧主 Canvas：独立一行，不受右侧行高变化影响 -->
                                    <Canvas fx:id="qualityCanvas"
                                            width="1200"
                                            height="800"
                                            GridPane.columnIndex="0"
                                            GridPane.rowIndex="0"
                                            GridPane.valignment="TOP" />

                                    <!-- 右侧折线图 / 柱状图 / 装配条 -->
                                    <GridPane fx:id="qualityRightGrid"
                                              GridPane.columnIndex="1"
                                              GridPane.rowIndex="0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="400" prefWidth="400" maxWidth="400" halignment="CENTER" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints minHeight="318" prefHeight="318" vgrow="NEVER" />
                                            <RowConstraints minHeight="318" prefHeight="318" vgrow="NEVER" />
                                            <RowConstraints minHeight="118" prefHeight="118" vgrow="NEVER" />
                                        </rowConstraints>

                                        <StackPane GridPane.columnIndex="0" GridPane.rowIndex="0" translateY="0">
                                            <Canvas fx:id="qualityLineCanvas"
                                                    width="700"
                                                    height="312" />
                                            <padding>
                                                <Insets left="-1100" />
                                            </padding>
                                        </StackPane>

                                        <StackPane fx:id="qualityFittingPane" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="1" translateY="-10"
                                                   prefHeight="318" maxHeight="318">
                                            <Canvas fx:id="qualityFittingCanvas"
                                                    width="700"
                                                    height="312" />
                                            <VBox alignment="BOTTOM_CENTER" spacing="0"
                                                  maxWidth="700" fillWidth="true">
                                                <Label fx:id="rowLabel" text="Row: 0"
                                                       style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                                                <Slider fx:id="qualitySlider"
                                                        min="0" max="0" blockIncrement="1" majorTickUnit="40"
                                                        minorTickCount="0" snapToTicks="false"
                                                        showTickLabels="true" showTickMarks="true"
                                                        prefWidth="600.0" maxWidth="620.0" />
                                            </VBox>
                                            <padding>
                                                <Insets left="-1100" bottom="2" />
                                            </padding>
                                        </StackPane>

                                        <StackPane fx:id="qualityAssemblyPane" GridPane.columnIndex="0" GridPane.rowIndex="2" translateY="-6">
                                            <Canvas fx:id="qualityAssemblyCanvas"
                                                    width="700"
                                                    height="115" />
                                            <padding>
                                                <Insets left="-1100" />
                                            </padding>
                                        </StackPane>
                                    </GridPane>
                                </GridPane>
                            </ScrollPane>
                        </Tab>


                    </tabs>
                </TabPane>
            </children>
        </AnchorPane>
    </items>
</SplitPane>
